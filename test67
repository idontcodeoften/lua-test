--[[
    PrismUI v1.9 - executor single-file build
    Load from a hosted raw file:
    local Prism = loadstring(game:HttpGet("RAW_GITHUB_URL"))()
    local Window = Prism:CreateWindow({
        Title = "My UI", Tags = { "BETA" },
        Subtitle = "auto",            -- or a custom string; "auto" shows @player
        Font = "BuilderSans",         -- any name in Prism.Fonts (Gotham, Montserrat, Ubuntu, Oswald, Michroma...)
        TopbarStats = true,           -- FPS / ping / clock chip in the top bar
        TopbarStyle = "default",      -- "default" | "mac" (traffic-light buttons)
        TitleGradient = true,         -- title text fades from text colour into the accent
        Breadcrumb = true,            -- shows "› Current tab" after the title
        Mobile = nil,                 -- nil = auto-detect touch, true/false to force
        MobileScale = 0.85,           -- UI scale used on phones when Scale isn't set
        Icon = nil,                   -- optional top-bar icon (asset id or icon name)
        PinButton = false,            -- true adds a pin button to the top bar
        Weather = nil,                -- "snow" | "rain" | "stars" | "sakura"
        LiquidGlass = false,          -- see-through glass panels with a moving sheen
        Edges3D = false,              -- bevelled 3D edges
        MobileButton = nil,           -- floating open/close bubble (default: on for touch)
        TextScale = 1,                -- 0.8 - 1.3
        Scale = nil,                  -- UI scale 0.5 - 1.5 (default: auto-fit to the screen)
        Density = "comfortable",      -- "comfortable" | "compact"
        Glass = 0,                    -- 0 = opaque, 1 = fully frosted
        Pattern = "none",             -- "none" | "dots" | "grid"
        Blob = false,                 -- accent blob fading in a page corner
        Glow = false,                 -- accent glow behind the window
        AnimatedBorder = false,       -- slowly rotating accent gradient border
        Rainbow = false,              -- slow hue-cycling accent
        Profile = true,               -- player card at the bottom of the sidebar
    })

    What's new in v1.9
      * 24 fonts (was 4): BuilderSans, Gotham, GothamBlack, Montserrat, SourceSans, Arimo, Ubuntu,
        Nunito, Roboto, RobotoCondensed, TitilliumWeb, Oswald, JosefinSans, Jura, Michroma, Sarpanch,
        Merriweather, FredokaOne, PatrickHand, Kalam, Arcade, SciFi, RobotoMono, Code.
        Fonts missing on a client are skipped automatically. Library.Fonts lists what's available.
      * New top bar: accent-tinted gradient background, gradient brand badge (your Icon, or the
        title's first letter; Icon = false hides it), accent-tinted tags, pulsing online dot by the
        subtitle, live FPS / ping / clock chip with a colour-coded FPS dot (cfg.TopbarStats = false),
        gradient underline with a moving shimmer, slowly rotating brand gradient with a soft glow,
        gradient title text (cfg.TitleGradient), a "› Current tab" breadcrumb (cfg.Breadcrumb),
        accent-tinted button hovers, and cfg.TopbarStyle = "mac" for traffic-light buttons.
      * Sidebar tabs get a gradient indicator bar and bold active label; sections get an accent dot;
        cards get a hairline border and slightly rounder corners.

    What's new in v1.8
      * Atmosphere: falling snow, rain, twinkling stars or sakura petals behind the window
        while it (or the key prompt) is open. Fades in/out with the window.
        cfg.Weather = "snow" | "rain" | "stars" | "sakura", cfg.WeatherDensity = 0.2..2.5,
        cfg.WeatherColor = Color3 | "accent".  Window:SetWeather(mode, { Density, Color }).
      * Liquid glass: see-through window and cards over the blurred game, a slowly moving
        light sheen and glossy rims. cfg.LiquidGlass = true / Window:SetLiquidGlass(on).
      * 3D edges: bevelled cards, buttons, widgets and window (light top edge, dark bottom
        edge; toggle tracks and the segmented control look pressed in).
        cfg.Edges3D = true / Window:SetEdges3D(on).
      * All three are in the Appearance tab and saved with configs.

    What's new in v1.7
      * Minimize turns the window into a pill-shaped bar at the top-centre of the screen.
        Drag it anywhere; tap/click it (without dragging) to restore. The pin is hidden there.
      * The window now drags from the top bar only, so sliders, pickers and other controls
        never move the window.
      * New top bar: optional icon (cfg.Icon), title with tags, subtitle underneath, and the
        pin / minimize / close buttons grouped in a pill. Window:SetTitle(t) / :SetSubtitle(t).
        cfg.PinButton = true adds a pin button (off by default since 1.8.2).
      * Tooltips: themed, follow the mouse after a short delay, stay on screen; on touch,
        press and hold a card to see its tooltip (the hold doesn't trigger the card).
        Built-in tooltips on the top bar, widgets, sliders, keybinds and colour pickers.
      * Phones get a smaller UI automatically (cfg.MobileScale, default 0.85; cfg.Scale
        overrides). The window still fits the screen at any scale.

    What's new in v1.6
      * Prism:CreateKeySystem({ Title, Subtitle, Note, Identifier, Provider, Service, SaveKey,
        Verify = function(key) -> ok, msg end, Copy = function() -> link end,
        OnVerified = function(key) end, OnInvalid = function(msg) end })
        returns { Window, Verify(key), Copy(), IsVerified(), Reset(), Prompt() }.
        Same API as the Junkie key system build; uses the new key prompt and now
        rejects keys when the key service can't be reached instead of letting them in.
        Prism:RegisterKeyProvider(id, spec) / RegisterCustomProvider(id, name, verify, copy)
        / RegisterHttpProvider(id, spec); pick one with cfg.KeyProvider = id.
      * Colour picker: saturation/brightness square, hue bar, optional transparency bar
        (Transparency = 0..1), old/new preview, hex + R/G/B fields, preset swatches,
        recent colours, Live = true for live callbacks. Callback(color, transparency).
        Works with touch and no longer drags the window while picking.

    What's new in v1.5
      * Key system: cfg.KeySystem = { Title, Note, Keys = {...} or Validate = function(key) -> ok, msg,
        Link = "https://...", SaveKey = true, OnSuccess = function(key) end }. The window stays
        locked until a valid key is entered; a saved key skips the prompt next time.
      * Keybinds: Mode = "Toggle" | "Hold" | "Always", mouse buttons (right/middle click),
        Backspace clears, Escape cancels. On touch, a keybind card becomes a tap/hold button.
      * Background blur while the window is open (cfg.Blur, cfg.BlurSize).
      * Pin button in the header: a pinned window can't be hidden, minimized or closed.
      * Floating widgets (draggable, lockable, collapsible, work with touch):
          Window:AddWidget({ Title })  :AddRow(name, value) :AddBar(name, 0..1) :AddText(t)
          Window:AddTargetWidget({ Mode = "nearest" | "manual" })  :SetTarget(player)
          Window:AddKeybindList()
      * Customization: theme editor, 4 new themes, window width/height, shadow, border,
        background image, animation speed (0 = reduce motion), widget opacity.
      * Columns now take widgets: local c = Tab:AddColumns(2); c[1]:AddToggle({...})
      * Removed the accent blob and the header accent dot.

    What's new in v1.4
      * Minimal look: flat header with a brand dot, borderless sidebar, plain icon
        buttons, solid accent controls (no gradients), slimmer sliders and switches.
      * Mobile: the window resizes to fit the screen (and re-fits on rotation), the
        sidebar turns into a horizontal tab strip on narrow screens, controls get
        larger touch targets, a draggable floating bubble opens/closes the UI, the
        window drags from the header only (so pages scroll normally), sliders lock
        page scrolling while dragged, and hover/tooltips are skipped on touch.
        On touch the X button hides the window (reopen with the bubble).

    What's new in v1.3
      * Sidebar search: filters every widget in every tab (Window:Search("text")).
      * Smooth theme / accent cross-fades, auto-fit + adjustable UI scale (Window:SetScale).
      * Cards get a hairline border that lights up on hover.
      * Window:Dialog({ Title, Message, Buttons = { { Text, Primary, Style, Callback } } })
      * Window:SetWatermark("Name", { Stats = true })  -- pill with FPS / ping
      * Window:LoadAutoload()  -- applies the profile marked "autoload" in the config tab
      * Slider values are editable (click the number and type).
      * Dropdowns get a search field when they have more than 7 entries.
      * Toggle: Keybind = Enum.KeyCode.X adds an inline rebindable hotkey; :SetDisabled(bool)
      * Button: Style = "primary" | "danger", ButtonText = "Run"; :SetTitle() :SetDisabled()
      * Tab:AddSegmented({ Values = {...}, Default = ..., Callback })
      * Tab:AddCallout({ Title, Message, Type = "info"|"success"|"warning"|"error" })
      * Tab:AddConsole({ Height = 150 })  :Log(text, "info"|"success"|"warning"|"error"|"debug")  :Clear()
      * Tab:AddKeyValue({ Rows = { {"Ping", "32 ms"} } })  :Set(key, value)  :SetRows(rows)
      * Tab:AddDivider("optional label")
      * Lazy-built background patterns (much cheaper than before).

    Elements from earlier versions:
      Tab:AddLineGraph({ Values = {...}, Height = 120 })   :Set({ ... })
      Tab:AddStatCard({ Title = "FPS", Value = 60, Delta = 4, Values = {...} })
      Tab:AddGauge({ Title = "Load", Default = 0.7, Suffix = "%" })  :Set(0..1)
      Tab:AddSkeleton({ Title = "Loading..." })            :Destroy()
      Tab:AddSection("Name") returns a section object with :Toggle() / :Set(open)
      local cols = Tab:AddColumns(2)  -- side-by-side columns; add widgets per column:
        cols[1]:AddToggle({ Title = "Left" })  cols[2]:AddSlider({ Title = "Right" })
    Widget cfg extras: Tooltip = "text", Badge = "NEW" (tabs + cards),
    Notify({ Title, Message (or Content), Type = "info"|"success"|"warning"|"error",
             Duration (0 = stays until dismissed), Color = Color3,
             Icon = "!" or "rbxassetid://..." }) returns { Dismiss }.
    Toasts stack with smooth reflow, pause on hover / touch-hold, dismiss by
    swipe right on touch or the close button, and adapt their width on mobile.
    Window:SetNotificationPosition("bottomright"|"bottomleft"|"topright"|"topleft"),
    or cfg.NotificationPosition at creation. The window is draggable from any
    non-interactive part of it (buttons, sliders and text boxes still work).
]]

