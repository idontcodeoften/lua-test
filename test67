                self:_bind(mark, "TextColor3", "AccentText")
            end
            local brandGrad = iconBox:FindFirstChildOfClass("UIGradient")
            local brandGlow = New("Frame", { Parent = top, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 28, 0.5, 0), Size = UDim2.fromOffset(44, 44), BorderSizePixel = 0, BackgroundTransparency = 0.88, ZIndex = 0 })
            New("UICorner", { Parent = brandGlow, CornerRadius = UDim.new(1, 0) })
            self:_bind(brandGlow, "BackgroundColor3", "Accent")
            self._brandGlow = brandGlow
            if brandGrad then
                brandGrad.Rotation = 0
                loopTween(self._loops, brandGrad, { Rotation = 360 }, 9)
            end
            brandGlow.BackgroundTransparency = 0.92
            loopTween(self._loops, brandGlow, { BackgroundTransparency = 0.8 }, 1.6, true, Enum.EasingStyle.Sine)
            iconBox.MouseEnter:Connect(function() tween(iconBox, { Rotation = -8 }, TI_POP) end)
