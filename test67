    -- Derive a full palette from a single accent colour (auto-theme).
    function Library.ThemeFromAccent(accent)
        local h, s, v = Color3.toHSV(accent)
        local function shade(sv, vv) return Color3.fromHSV(h, sv, vv) end
        return {
            Background = shade(math.min(s * 0.55, 0.5), math.max(0.055, v * 0.09)),
            Surface    = shade(math.min(s * 0.60, 0.5), math.max(0.085, v * 0.14)),
            Elevated   = shade(math.min(s * 0.65, 0.5), math.max(0.125, v * 0.20)),
            Stroke     = shade(math.min(s * 0.70, 0.5), math.max(0.175, v * 0.28)),
            Text       = Color3.new(1, 1, 1):Lerp(shade(s, 1), 0.88),
            SubText    = shade(math.min(s * 0.35, 0.35), 0.62),
            Accent     = accent,
        }
    end

    ------------------------------------------------------------------ helpers
    local function New(class, props, children)
        local inst = Instance.new(class)
        local parent
        for k, v in pairs(props or {}) do
            if k == "Parent" then parent = v else inst[k] = v end
        end
        for _, c in ipairs(children or {}) do c.Parent = inst end
        inst.Parent = parent
        return inst
    end

    local ANIM = { speed = 1 } -- global animation speed; 0 = no animation
    local function tween(inst, props, info)
        info = info or TI
        if ANIM.speed <= 0 then
            for k, v in pairs(props) do inst[k] = v end
            return
        end
        if ANIM.speed ~= 1 then
            info = TweenInfo.new(info.Time / ANIM.speed, info.EasingStyle, info.EasingDirection, info.RepeatCount, info.Reverses, info.DelayTime)
        end
        TweenService:Create(inst, info, props):Play()
    end

    -- Looping tweens run inside the engine, so they cost far less than a Heartbeat callback.
    -- Each window keeps its loops in a list and pauses them while it's hidden or minimized.
    local function loopTween(list, inst, props, time, reverses, style)
        local info = TweenInfo.new(time, style or Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1, reverses == true)
        local tw = TweenService:Create(inst, info, props)
        table.insert(list, tw)
        if ANIM.speed > 0 then tw:Play() end
        return tw
    end

    -- Upright pin glyph made from frames. Returns (holder, setColor).
    local function drawPin(parent)
        local holder = New("Frame", { Parent = parent, BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(12, 14) })
        local head = New("Frame", { Parent = holder, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 0), Size = UDim2.fromOffset(6, 6), BorderSizePixel = 0 })
        New("UICorner", { Parent = head, CornerRadius = UDim.new(0, 2) })
        local bar = New("Frame", { Parent = holder, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 6), Size = UDim2.fromOffset(12, 2), BorderSizePixel = 0 })
        New("UICorner", { Parent = bar, CornerRadius = UDim.new(1, 0) })
        local needle = New("Frame", { Parent = holder, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 8), Size = UDim2.fromOffset(2, 6), BorderSizePixel = 0 })
        return holder, function(c) head.BackgroundColor3 = c; bar.BackgroundColor3 = c; needle.BackgroundColor3 = c end
    end

    local function safe(fn, ...)
        if type(fn) ~= "function" then return end
        local ok, err = pcall(fn, ...)
        if not ok then warn("[PrismUI] callback error: " .. tostring(err)) end
    end

    local function isPress(i) return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch end
    local function isMove(i)  return i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch end

    local function pad(parent, t, r, b, l)
        return New("UIPadding", {
            Parent = parent,
            PaddingTop    = UDim.new(0, t),
            PaddingRight  = UDim.new(0, r or t),
            PaddingBottom = UDim.new(0, b or t),
            PaddingLeft   = UDim.new(0, l or r or t),
        })
    end

    local function formatNumber(v)
        if type(v) ~= "number" then return tostring(v) end
        if v == math.floor(v) then return tostring(math.floor(v)) end
        return string.format("%.2f", v)
    end

    local function resolveIcon(icon)
        if type(icon) == "number" then return "rbxassetid://" .. tostring(icon) end
        if type(icon) ~= "string" then return nil end
        if icon:match("^rbxassetid://%d+$") then return icon end
        if icon:match("^%d+$") then return "rbxassetid://" .. icon end
        return ICONS[icon:lower()]
    end

    local function hexToColor3(hex)
        hex = hex:gsub("#", "")
        local r = tonumber(hex:sub(1,2), 16) or 0
        local g = tonumber(hex:sub(3,4), 16) or 0
        local b = tonumber(hex:sub(5,6), 16) or 0
        return Color3.fromRGB(r, g, b)
    end

    local function color3ToHex(c)
        return string.format("#%02X%02X%02X", math.floor(c.R*255+0.5), math.floor(c.G*255+0.5), math.floor(c.B*255+0.5))
    end

    local function shiftHue(c, deg)
        local h, s, v = Color3.toHSV(c)
        return Color3.fromHSV((h + deg / 360) % 1, s, v)
    end

    local function keyName(k)
        return (k == nil or k == Enum.KeyCode.Unknown) and "None" or k.Name
    end

    ------------------------------------------------------------------ window internals
    function Window:_buildTheme()
        local t = table.clone(type(self._themeName) == "table" and self._themeName or Library.Themes[self._themeName] or Library.Themes.Midnight)
        for k, v in pairs(Library.Themes.Midnight) do if t[k] == nil then t[k] = v end end
        if self._accent then t.Accent = self._accent end
        local a = t.Accent
        t.AccentText = (0.299 * a.R + 0.587 * a.G + 0.114 * a.B) > 0.62 and rgb(15,15,20) or Color3.new(1,1,1)
        self.Theme = t
    end

    function Window:_onTheme(inst, fn)
        table.insert(self._painters, { inst = inst, fn = fn })
        fn()
    end

    function Window:_bind(inst, prop, key)
        self:_onTheme(inst, function() inst[prop] = self.Theme[key] end)
    end

    -- Accent -> hue-shifted accent gradient (multiplies the instance colour,
    -- so the instance should be white for exact colours).
    function Window:_gradient(inst, shift, rotation, fromKey, toKey)
        local g = New("UIGradient", { Parent = inst, Rotation = rotation or 0 })
        self:_onTheme(inst, function()
            local a = type(fromKey) == "string" and self.Theme[fromKey] or fromKey or self.Theme.Accent
            local b = type(toKey) == "string" and self.Theme[toKey] or toKey or shiftHue(a, shift or 25)
            g.Color = ColorSequence.new(a, b)
        end)
        return g
    end

    -- Glass: keeps a background at a theme-driven transparency.
    function Window:_glassify(inst, maxT)
        self:_onTheme(inst, function() inst.BackgroundTransparency = (self._glass or 0) * maxT end)
    end

    function Window:_refresh()
        for i = #self._painters, 1, -1 do
            local p = self._painters[i]
            if p.inst.Parent == nil then table.remove(self._painters, i) else pcall(p.fn) end
        end
        for i = #self._textRegs, 1, -1 do
            local r = self._textRegs[i]
            if r.inst.Parent == nil then table.remove(self._textRegs, i) end
        end
    end

    -- Cross-fades from the current theme to whatever `apply` sets up.
    function Window:_transition(apply)
        local old = self.Theme
        apply()
        self:_buildTheme()
        local target = self.Theme
        self._targetTheme = target
        for _, fn in ipairs(self._themeListeners or {}) do pcall(fn, target) end
        self._themeToken = (self._themeToken or 0) + 1
        local token = self._themeToken
        if self._themeConn then self._themeConn:Disconnect(); self._themeConn = nil end
        if not old or self._rainbow or not self._animateTheme then self:_refresh() return end
        local t0, dur = os.clock(), 0.28
        local conn
        conn = RunService.Heartbeat:Connect(function()
            if token ~= self._themeToken or not self.Gui.Parent then conn:Disconnect() return end
            local a = math.clamp((os.clock() - t0) / dur, 0, 1)
            if a >= 1 then
                conn:Disconnect()
                if self._themeConn == conn then self._themeConn = nil end
                self.Theme = target
                self:_refresh()
                return
            end
            local e = 1 - (1 - a) ^ 3
            local mix = {}
            for k, v in pairs(target) do
                mix[k] = (typeof(v) == "Color3" and old[k]) and old[k]:Lerp(v, e) or v
            end
            self.Theme = mix
            self:_refresh()
        end)
        self._themeConn = conn
    end

    function Window:_applyCorner(e)
        if self._minimized and (e.corner == self._mainCorner or e.corner == self._bgCorner or e.corner == self._rimCorner or e.corner == self._sheenCorner) then
            e.corner.CornerRadius = UDim.new(1, 0)
            return
        end
        local r = self.CornerRadius
        if e.scale == "pill" then
            e.corner.CornerRadius = r <= 0 and UDim.new(0, 0) or UDim.new(1, 0)
        else
            e.corner.CornerRadius = UDim.new(0, math.floor(r * e.scale + 0.5))
        end
    end

    function Window:_corner(parent, scale)
        local c = New("UICorner", { Parent = parent })
        local e = { corner = c, scale = scale }
        table.insert(self._corners, e)
        self:_applyCorner(e)
        return c
    end

    function Window:_stroke(parent, key, thickness)
        local s = New("UIStroke", { Parent = parent, Thickness = thickness or 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
        self:_bind(s, "Color", key or "Stroke")
        return s
    end

    -- Edge stroke that switches between: 3D bevel, liquid-glass highlight, a flat border, or nothing.
    -- opts.inset = pressed-in look; opts.flat = { key = "Stroke", t = 0.35 } border when effects are off.
    local function kp(t, v) return NumberSequenceKeypoint.new(t, v) end
    function Window:_edge(inst, opts)
        opts = opts or {}
        local st = New("UIStroke", { Name = "Edge", Parent = inst, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
        local g = New("UIGradient", { Parent = st, Rotation = 90 })
        local WHITE, BLACK = Color3.new(1, 1, 1), Color3.new(0, 0, 0)
        self:_onTheme(inst, function()
            if opts.hide and opts.hide() then
                st.Enabled = false
            elseif self._bevel then
                local hi, lo = WHITE, BLACK
                if opts.inset then hi, lo = BLACK, WHITE end
                st.Enabled, st.Color, st.Transparency, st.Thickness = true, WHITE, 0, opts.inset and 1 or 1.25
                g.Enabled = true
                g.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, hi), ColorSequenceKeypoint.new(0.5, hi:Lerp(lo, 0.5)), ColorSequenceKeypoint.new(1, lo) })
                g.Transparency = NumberSequence.new({ kp(0, opts.inset and 0.55 or 0.5), kp(0.5, 0.8), kp(1, opts.inset and 0.75 or 0.6) })
            elseif self._liquid then
                st.Enabled, st.Color, st.Transparency, st.Thickness = true, WHITE, 0, 1
                g.Enabled = true
                g.Color = ColorSequence.new(WHITE)
                g.Transparency = NumberSequence.new({ kp(0, opts.inset and 0.9 or 0.55), kp(0.5, 0.8), kp(1, opts.inset and 0.85 or 0.86) })
            elseif opts.flat then
                st.Enabled, st.Thickness = true, 1
                g.Enabled = false
                st.Color = self.Theme[opts.flat.key or "Stroke"]
                st.Transparency = opts.flat.t or 0
            else
                st.Enabled = false
            end
        end)
        return st
    end

    function Window:_text(parent, text, size, font, key)
        local l = New("TextLabel", {
            Parent = parent, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, self:_ts(size) + 2),
            AutomaticSize = Enum.AutomaticSize.Y, Text = text or "", TextSize = self:_ts(size), Font = font,
            TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
        })
        self:_styleLabel(l, font == FONT_MAP[self._fontName].Bold and "Bold" or (font == FONT_MAP[self._fontName].Medium and "Medium" or "Normal"), size)
        self:_bind(l, "TextColor3", key)
        return l
    end

    -- Registers a label so font + text scale can be changed live.
    function Window:_styleLabel(inst, weight, size)
        table.insert(self._textRegs, { inst = inst, weight = weight or "Normal", size = size or 13 })
        return inst
    end

    function Window:_ts(n) return math.floor((n or 13) * (self.TextScale or 1) + 0.5) end
    function Window:_font(weight) return (FONT_MAP[self._fontName] or FONT_MAP.Gotham)[weight or "Normal"] end

    -- Hover tooltip.
    -- Themed tooltip. Mouse: hover for a moment, follows the cursor. Touch: press and hold.
    function Window:_tooltip(inst, text)
        if not text or text == "" then return end
        local tip, token = nil, 0
        local function kill()
            token += 1
            if tip then
                local t = tip
                tip = nil
                tween(t, { BackgroundTransparency = 1, TextTransparency = 1 }, TweenInfo.new(0.1))
                local st = t:FindFirstChildOfClass("UIStroke")
                if st then tween(st, { Transparency = 1 }, TweenInfo.new(0.1)) end
                task.delay(0.12, function() t:Destroy() end)
            end
        end
        -- pos is in screen pixels (top bar included), which is this gui's offset space
        local function place(pos, above)
            if not tip then return end
            local vp = self.Gui.AbsoluteSize
            local ts = tip.AbsoluteSize
            local x = math.clamp(pos.X + (above and -ts.X / 2 or 14), 6, math.max(6, vp.X - ts.X - 6))
            local y = math.clamp(pos.Y - (above and 28 or 10), ts.Y + 6, math.max(ts.Y + 6, vp.Y - 6))
            tip.Position = UDim2.fromOffset(x, y)
        end
        local function show(pos, above)
            kill()
            tip = New("TextLabel", {
                Parent = self.Gui, Text = text, Font = self:_font("Medium"), TextSize = self:_ts(12),
                AnchorPoint = Vector2.new(0, 1), AutomaticSize = Enum.AutomaticSize.XY, Size = UDim2.fromOffset(0, 0),
                ZIndex = 200, BorderSizePixel = 0, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left,
                BackgroundColor3 = self.Theme.Elevated, TextColor3 = self.Theme.Text,
                BackgroundTransparency = 1, TextTransparency = 1,
            })
            New("UISizeConstraint", { Parent = tip, MaxSize = Vector2.new(240, math.huge) })
            New("UICorner", { Parent = tip, CornerRadius = UDim.new(0, 8) })
            New("UIStroke", { Parent = tip, Thickness = 1, Color = self.Theme.Stroke, Transparency = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
            pad(tip, 6, 10)
            place(pos, above)
            task.defer(function() place(pos, above) end) -- once its size is known
            tween(tip, { BackgroundTransparency = 0.02, TextTransparency = 0 }, TweenInfo.new(0.12))
            tween(tip:FindFirstChildOfClass("UIStroke"), { Transparency = 0.2 }, TweenInfo.new(0.12))
        end

        -- mouse
        inst.MouseEnter:Connect(function()
            if self._touch then return end
            kill()
            local my = token
            task.delay(0.35, function()
                if my == token and inst.Parent and inst.Visible ~= false then
                    show(UserInputService:GetMouseLocation())
                    token = my
                end
            end)
        end)
        inst.MouseMoved:Connect(function()
            if tip and not self._touch then place(UserInputService:GetMouseLocation()) end
        end)
        inst.MouseLeave:Connect(kill)
        inst.Destroying:Connect(kill)

        -- touch: press and hold
        local pressInput, pressPos = nil, nil
        inst.InputBegan:Connect(function(i)
            if i.UserInputType ~= Enum.UserInputType.Touch then return end
            pressInput = i
            -- input positions exclude the top bar; this gui's offsets include it
            pressPos = Vector2.new(i.Position.X, i.Position.Y) + GuiService:GetGuiInset()
            local start = Vector2.new(i.Position.X, i.Position.Y)
            local my = token
            task.delay(0.45, function()
                if my ~= token or pressInput ~= i or not inst.Parent then return end
                local now = Vector2.new(i.Position.X, i.Position.Y)
                if (now - start).Magnitude > 12 then return end -- it was a scroll
                self._lp[inst] = os.clock()
                show(pressPos, true)
                token = my
            end)
        end)
        inst.InputEnded:Connect(function(i)
            if i ~= pressInput then return end
            pressInput = nil
            if tip then
                local my = token
                task.delay(1.4, function() if my == token then kill() end end)
            else
                token += 1
            end
        end)
    end

    -- true (once) if this card was just long-pressed to show a tooltip, so the press shouldn't count
    function Window:_consumeLongPress(inst)
        local t = self._lp and self._lp[inst]
        if t and os.clock() - t < 2 then self._lp[inst] = nil; return true end
        return false
    end

    function Window:_connect(signal, fn) table.insert(self._conns, signal:Connect(fn)) end

    ------------------------------------------------------------------ public window API
    function Window:SetTheme(theme)
        self:_transition(function() self._themeName = theme end)
    end
    function Window:SetAccent(color)
        self:_transition(function() self._accent = color; self._baseAccent = color end)
    end
    function Window:GetTheme() return self.Theme end

    function Window:SetFont(name)
        self._fontName = FONT_MAP[name] and name or "Gotham"
        for _, r in ipairs(self._textRegs) do
            r.inst.Font = self:_font(r.weight)
            r.inst.TextSize = self:_ts(r.size)
        end
        self:_refresh()
    end

    function Window:SetTextScale(scale)
        self.TextScale = math.clamp(tonumber(scale) or 1, 0.8, 1.3)
        for _, r in ipairs(self._textRegs) do r.inst.TextSize = self:_ts(r.size) end
    end

    function Window:SetScale(scale)
        self._userScale = math.clamp(tonumber(scale) or 1, 0.5, 1.5)
        if self._fitSize then
            self._size = self._fitSize()
            if not self._minimized and self.Holder then self.Holder.Size = UDim2.fromOffset(self._size.X, self._size.Y) end
            self:_layout()
        end
        if self._scale and self._open then tween(self._scale, { Scale = self._userScale }, TI) end
    end
    function Window:GetScale() return self._userScale end

    function Window:SetDensity(mode)
        self.Density = mode == "compact" and "compact" or "comfortable"
        local c = self.Density == "compact"
        local t = self._touch
        self._d = { cardPad = c and 8 or (t and 13 or 11), gap = c and 5 or 6, rowH = c and 24 or 28, headerH = c and 20 or (t and 28 or 24) }
        -- Live-update paddings/gaps made density-aware.
        for _, e in ipairs(self._densityRegs) do e.fn(self._d) end
    end

    function Window:SetGlass(t)
        self._glass = math.clamp(tonumber(t) or 0, 0, 1)
        self:_refresh()
    end

    -- Patterns are built lazily the first time they are shown.
    function Window:SetPattern(mode)
        self._pattern = mode
        for _, kind in ipairs({ "dots", "grid" }) do
            if mode == kind and not self._patterns[kind] and self._buildPattern then
                self._patterns[kind] = self._buildPattern(kind)
            end
            if self._patterns[kind] then self._patterns[kind].Visible = mode == kind end
        end
    end

    function Window:SetBlob() end -- removed in 1.5 (kept so old scripts don't error)

    function Window:SetGlow(on)
        self._glow = on == true
        if self._glowImage then self._glowImage.Visible = self._glow end
    end

    local NOTIF_POSITIONS = {
        bottomright = { anchor = Vector2.new(1, 1), pos = UDim2.new(1, -20, 1, -20), align = Enum.VerticalAlignment.Bottom },
        bottomleft  = { anchor = Vector2.new(0, 1), pos = UDim2.new(0, 20, 1, -20),  align = Enum.VerticalAlignment.Bottom },
        topright    = { anchor = Vector2.new(1, 0), pos = UDim2.new(1, -20, 0, 20),  align = Enum.VerticalAlignment.Top },
        topleft     = { anchor = Vector2.new(0, 0), pos = UDim2.new(0, 20, 0, 20),   align = Enum.VerticalAlignment.Top },
    }

    function Window:SetAnimatedBorder(on)
        self._animBorder = on == true
        if not self._borderStroke then return end
        if on then
            if not self._borderGrad then
                -- UIGradient multiplies the stroke colour, so force the stroke
                -- to white and let the gradient supply the accent colours.
                self._borderGrad = New("UIGradient", { Parent = self._borderStroke, Rotation = 0 })
                self:_onTheme(self._borderStroke, function()
                    local a = self.Theme.Accent
                    self._borderGrad.Color = ColorSequence.new(a, shiftHue(a, -60))
                    self._borderStroke.Color = Color3.new(1, 1, 1)
                    self._borderStroke.Thickness = 1.6
                end)
            end
            if not self._borderConn then
                self._borderGrad.Rotation = 0
                self._borderConn = loopTween(self._loops, self._borderGrad, { Rotation = 360 }, 6)
                if not self._loopsRunning then self._borderConn:Pause() end
            end
        else
            if self._borderConn then
                self._borderConn:Cancel()
                table.remove(self._loops, table.find(self._loops, self._borderConn) or 0)
                self._borderConn = nil
            end
            if self._borderGrad then self._borderGrad:Destroy(); self._borderGrad = nil end
            self._borderStroke.Thickness = 1
            self:_refresh() -- restores the bound Stroke colour
        end
    end

    function Window:SetRainbow(on)
        self._rainbow = on == true
        if on then
            if not self._rainbowConn then
                self._rainbowConn = RunService.Heartbeat:Connect(function()
                    if not self._open or self._minimized or os.clock() - (self._lastHue or 0) < 1 / 12 then return end
                    self._lastHue = os.clock()
                    self._accent = Color3.fromHSV((os.clock() * 0.06) % 1, 0.6, 1)
                    self:_buildTheme(); self:_refresh()
                end)
                table.insert(self._conns, self._rainbowConn)
            end
        else
            if self._rainbowConn then self._rainbowConn:Disconnect(); self._rainbowConn = nil end
            self:_transition(function() self._accent = self._baseAccent end)
        end
    end

    function Window:SetCornerRadius(r)
        self.CornerRadius = math.clamp(r, 0, 28)
        self:_paintShadow()
        for i = #self._corners, 1, -1 do
            local e = self._corners[i]
            if e.corner.Parent == nil then table.remove(self._corners, i) else self:_applyCorner(e) end
        end
    end

    function Window:Toggle(state)
        if self._locked then return end
        if state == nil then state = not self._open end
        if not state and self._pinned then self:_pinNudge() return end
        self._open = state
        self._visibilityToken = (self._visibilityToken or 0) + 1
        local token = self._visibilityToken
        if state then
            self.Holder.Visible = true
            self._scale.Scale = 0.94 * self._userScale
            tween(self._scale, { Scale = self._userScale }, TI_POP)
        else
            tween(self._scale, { Scale = 0.94 * self._userScale }, TI)
            task.delay(0.18 / math.max(ANIM.speed, 0.01), function()
                if self._visibilityToken == token and not self._open and self.Holder.Parent then
                    self.Holder.Visible = false
                end
            end)
        end
        self:_syncBlur()
        self:_syncLoops()
    end

    function Window:IsOpen() return self._open == true end

    function Window:_syncLoops()
        local run = self._open and not self._minimized and ANIM.speed > 0 and not self._locked
        if run == self._loopsRunning then return end
        self._loopsRunning = run
        for _, tw in ipairs(self._loops or {}) do
            if run then tw:Play() else tw:Pause() end
        end
    end

    ------------------------------------------------------------------ blur / pin / look
    function Window:_syncBlur()
        local want = self._blurOn and ((self._locked and self._gate ~= nil) or (self._open and not self._minimized))
        if want and not self._blur then
            local ok, b = pcall(function()
                return New("BlurEffect", { Name = "PrismBlur", Size = 0, Parent = Lighting })
            end)
            if ok then self._blur = b end
        end
        if self._blur then
            tween(self._blur, { Size = want and self._blurSize or 0 }, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out))
        end
    end

    function Window:SetBlur(on, size)
        self._blurOn = on == true
        if size then self._blurSize = math.clamp(tonumber(size) or 14, 0, 56) end
        self:_syncBlur()
    end
    function Window:SetBlurSize(size) self:SetBlur(self._blurOn, size) end

    function Window:SetPinned(on, quiet)
        self._pinned = on == true
        if self._pinPaint then self._pinPaint() end
        if self._pinned then
            if self._minimized then self._pinned = false; self:SetMinimized(false); self._pinned = true end
            if not self._open then self._pinned = false; self:Toggle(true); self._pinned = true end
        end
        if not quiet then
            self:Notify({ Title = self._pinned and "Window pinned" or "Window unpinned",
                Message = self._pinned and "It stays open until you unpin it." or nil, Type = "info", Duration = 2 })
        end
    end
    function Window:IsPinned() return self._pinned == true end

    function Window:_pinNudge()
        if os.clock() - (self._lastNudge or 0) < 1.5 then return end
        self._lastNudge = os.clock()
        if self._pinBtn then
            tween(self._pinBtn, { Rotation = -12 }, TweenInfo.new(0.06))
            task.delay(0.07, function() tween(self._pinBtn, { Rotation = 10 }, TweenInfo.new(0.06)) end)
            task.delay(0.14, function() tween(self._pinBtn, { Rotation = 0 }, TI_POP) end)
        end
        self:Notify({ Title = "Window is pinned", Message = "Unpin it to hide or close the window.", Type = "warning", Duration = 2.5 })
    end

    function Window:SetShadow(on)
        self._shadowOn = on == true
        if self._shadow then self._shadow.Visible = self._shadowOn end
    end

    function Window:_paintShadow()
        for _, l in ipairs(self._shadowLayers or {}) do
            if self._minimized then
                l.corner.CornerRadius = UDim.new(1, 0)
                l.layer.BackgroundTransparency = math.min(1, l.t + 0.05)
            else
                l.corner.CornerRadius = UDim.new(0, self.CornerRadius <= 0 and 0 or self.CornerRadius + l.grow)
                l.layer.BackgroundTransparency = l.t
            end
        end
    end

    function Window:SetBorder(on)
        self._borderOn = on ~= false
        self:_refresh()
    end

    function Window:SetAnimationSpeed(v)
        ANIM.speed = math.clamp(tonumber(v) or 1, 0, 3)
        self._animSpeed = ANIM.speed
        self._loopsRunning = nil
        self:_syncLoops()
    end

    function Window:SetBackgroundImage(image, transparency)
        if image ~= nil then
            local id = tostring(image)
            if id:match("^%d+$") then id = "rbxassetid://" .. id end
            self._bgImage = id
        end
        if transparency ~= nil then self._bgImageT = math.clamp(tonumber(transparency) or 0.8, 0, 1) end
        if self._bgImageLabel then
            self._bgImageLabel.Image = self._bgImage or ""
            self._bgImageLabel.ImageTransparency = self._bgImageT or 0.8
            self._bgImageLabel.Visible = (self._bgImage or "") ~= ""
        end
    end

    function Window:SetWidgetTransparency(t)
        self._widgetT = math.clamp(tonumber(t) or 0.08, 0, 0.9)
        self:_refresh()
    end

    function Window:SetMobileButtonVisible(on)
        if self._fab then self._fab.Visible = on ~= false and not self._locked end
    end

    function Window:Center()
        tween(self.Holder, { Position = UDim2.fromScale(0.5, 0.5) }, TI_POP)
    end

    function Window:SetSize(size)
        self._baseSize = size
        self._size = self._fitSize and self._fitSize() or size
        if not self._minimized then
            tween(self.Holder, { Size = UDim2.fromOffset(self._size.X, self._size.Y) }, TI_POP)
        end
        self:_layout()
    end

    ------------------------------------------------------------------ liquid glass / 3D edges
    function Window:SetLiquidGlass(on)
        on = on == true
        if on == (self._liquid == true) then return end
        self._liquid = on
        if on then
            self._glassBeforeLiquid = self._glass
            self._glass = math.max(self._glass or 0, 0.55)
            if not self._blurOn then self._blurOn = true; self._liquidBlur = true end
        else
            self._glass = self._glassBeforeLiquid or 0
            if self._liquidBlur then self._blurOn = false; self._liquidBlur = nil end
        end
        if self._sheen then self._sheen.Visible = on end
        self:_refresh()
        self:_syncBlur()
    end
    function Window:SetEdges3D(on)
        self._bevel = on == true
        self:_refresh()
    end
    Window.SetBevel = Window.SetEdges3D

    ------------------------------------------------------------------ atmosphere (snow / rain / stars / sakura)
    local WEATHER_COUNT = { snow = 70, rain = 90, stars = 60, sakura = 26 }
    local WEATHER_TINT = { snow = Color3.new(1, 1, 1), rain = rgb(170, 196, 236), stars = Color3.new(1, 1, 1), sakura = rgb(255, 183, 213) }

    function Window:SetWeather(mode, opts)
        opts = opts or {}
        mode = string.lower(tostring(mode or "none"))
        if not WEATHER_COUNT[mode] then mode = "none" end
        self._weather = mode
        if opts.Density ~= nil then self._weatherDensity = math.clamp(tonumber(opts.Density) or 1, 0.2, 2.5) end
        if opts.Color ~= nil then self._weatherColor = opts.Color end
        for _, p in ipairs(self._fxParts or {}) do p.f:Destroy() end
        self._fxParts = {}
        if not self._fx then
            self._fx = New("Frame", { Name = "Atmosphere", Parent = self.Gui, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 0, Visible = false })
            self._fxAlpha = 0
            self:_onTheme(self._fx, function() self:_paintFx() end)
            self:_connect(RunService.Heartbeat, function(dt) self:_stepFx(dt) end)
        end
        if mode == "none" then self._fx.Visible = false return end
        local cam = workspace.CurrentCamera
        local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
        local n = math.floor(WEATHER_COUNT[mode] * (self._weatherDensity or 1) * (self._touch and 0.6 or 1) + 0.5)
        for _ = 1, n do
            local p = { phase = math.random() * 6.283, x = math.random(), y = math.random() }
            local f = New("Frame", { Parent = self._fx, AnchorPoint = Vector2.new(0.5, 0.5), BorderSizePixel = 0, BackgroundTransparency = 1 })
            if mode == "snow" then
                p.size = math.random(2, 5)
                p.vy = 0.035 + math.random() * 0.06 + p.size * 0.006
                p.sway, p.base = 0.004 + math.random() * 0.01, 0.15 + math.random() * 0.4
                f.Size = UDim2.fromOffset(p.size, p.size)
                New("UICorner", { Parent = f, CornerRadius = UDim.new(1, 0) })
            elseif mode == "rain" then
                local len = math.random(12, 22)
                p.vy = 0.9 + math.random() * 0.6
                p.vx = p.vy * 0.12
                p.base = 0.45 + math.random() * 0.3
                f.Size = UDim2.fromOffset(1, len)
                f.Rotation = -math.deg(math.atan2(p.vx * vp.X, p.vy * vp.Y))
            elseif mode == "stars" then
                p.size = math.random(1, 3)
                p.vy, p.tw = -(0.002 + math.random() * 0.006), 0.8 + math.random() * 2
                p.base = 0.1 + math.random() * 0.3
                f.Size = UDim2.fromOffset(p.size, p.size)
                New("UICorner", { Parent = f, CornerRadius = UDim.new(1, 0) })
            elseif mode == "sakura" then
                p.size = math.random(6, 10)
                p.vy, p.vx = 0.045 + math.random() * 0.05, 0.015 + math.random() * 0.03
                p.sway, p.spin = 0.012, (math.random() - 0.5) * 220
                p.base = 0.1 + math.random() * 0.25
                f.Size = UDim2.fromOffset(p.size, math.floor(p.size * 0.65))
                New("UICorner", { Parent = f, CornerRadius = UDim.new(1, 0) })
            end
            p.f = f
            table.insert(self._fxParts, p)
        end
        self:_paintFx()
    end

    function Window:_paintFx()
        local mode = self._weather
        local c = self._weatherColor
        if c == "accent" then c = self.Theme.Accent elseif typeof(c) ~= "Color3" then c = WEATHER_TINT[mode] end
        if not c then return end
        for i, p in ipairs(self._fxParts or {}) do
            -- a little variety for petals
            p.f.BackgroundColor3 = (mode == "sakura" and i % 3 == 0) and c:Lerp(Color3.new(1, 1, 1), 0.35) or c
        end
    end

    function Window:_stepFx(dt)
        if not self._fx or self._weather == nil or self._weather == "none" then return end
        self._fxAcc = (self._fxAcc or 0) + dt
        if self._fxAcc < 1 / 40 and self._fx.Visible then return end
        dt, self._fxAcc = self._fxAcc, 0
        local want = (self._locked and self._gate ~= nil) or (self._open and not self._minimized) or self._weatherAlways
        local a = self._fxAlpha or 0
        if want and a < 1 then a = math.min(1, a + dt * 2.5) elseif not want and a > 0 then a = math.max(0, a - dt * 3) end
        self._fxAlpha = a
        if a <= 0 then self._fx.Visible = false return end
        self._fx.Visible = true
        dt = math.min(dt, 0.1) * math.max(ANIM.speed, 0.15)
        local t = os.clock()
        local mode = self._weather
        for _, p in ipairs(self._fxParts) do
            local tr = p.base
            p.y += p.vy * dt
            if mode == "stars" then
                if p.y < -0.02 then p.y, p.x = 1.02, math.random() end
                tr = p.base + (1 - p.base) * 0.65 * (0.5 + 0.5 * math.sin(t * p.tw + p.phase))
                p.f.Position = UDim2.fromScale(p.x, p.y)
            else
                p.x += (p.vx or 0) * dt
                if p.y > 1.05 then p.y, p.x = -0.05, math.random() * 1.1 - (p.vx and 0.12 or 0) end
                if p.x > 1.05 then p.x -= 1.1 end
                local x = p.x + (p.sway and math.sin(t * 1.3 + p.phase) * p.sway or 0)
                p.f.Position = UDim2.fromScale(x, p.y)
                if p.spin then p.f.Rotation = (t * p.spin + p.phase * 57) % 360 end
            end
            p.f.BackgroundTransparency = 1 - (1 - tr) * a
        end
    end

    -- Minimize / restore only changes the window's outer shell (pill corners, shadow, header). Repainting
    -- every widget in every tab (_refresh) and every corner (SetCornerRadius) on each toggle was the main
    -- cause of the laggy animation in big UIs. The shell lists are cached and rebuilt when widgets are added.
    function Window:_shellRepaint()
        local body = self._body
        local cache = self._shellCache
        if not cache or cache.np ~= #self._painters or cache.nc ~= #self._corners then
            cache = { painters = {}, corners = {}, np = #self._painters, nc = #self._corners }
            for _, p in ipairs(self._painters) do
                if p.inst.Parent ~= nil and not (body and p.inst:IsDescendantOf(body)) then table.insert(cache.painters, p) end
            end
            for _, e in ipairs(self._corners) do
                if e.corner.Parent ~= nil and not (body and e.corner:IsDescendantOf(body)) then table.insert(cache.corners, e) end
            end
            self._shellCache = cache
        end
        self:_paintShadow()
        for _, e in ipairs(cache.corners) do if e.corner.Parent then self:_applyCorner(e) end end
        for _, p in ipairs(cache.painters) do if p.inst.Parent then pcall(p.fn) end end
    end

    function Window:SetMinimized(state)
        if state == nil then state = not self._minimized end
        state = state == true
        if state and self._pinned then self:_pinNudge() return end
        if state == (self._minimized == true) then return end
        self._minimized = state
        if self._crumb then self._crumb.Visible = not state end
        task.defer(function() self:_syncLoops() end)
        task.defer(function() self:_syncBlur() end)
        self._minIcon.Image = resolveIcon(state and "maximize-2" or "minimize-2")
        self._minimizeToken = (self._minimizeToken or 0) + 1
        local H = self._headerH
        if state then
            -- shrink into a pill-shaped bar at the top-centre of the screen
            self._preMinimizePos = self.Holder.Position
            local cam = workspace.CurrentCamera
            local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
            local inset = GuiService:GetGuiInset()
            local sc = self._userScale or 1
            local y = math.max(inset.Y / 2, H * sc / 2 + 6)
            self._body.Visible = false
            self._headerLine.Visible = false
            if self._pinBtn then self._pinBtn.Visible = false end
            if self._subLabel then self._subLabel.Visible = false end
            -- single centred line, a little more room from the rounded end
            self._line1.AnchorPoint = Vector2.new(0, 0.5)
            self._line1.Position = UDim2.new(0, 0, 0.5, 0)
            self._titleBlock.Position = UDim2.fromOffset(self._leftX + 6, 0)
            self:_headerRelayout()
            -- width fits the title + tags + buttons
            local acs = self._titleLayout and self._titleLayout.AbsoluteContentSize
            local contentW = (acs and acs.X > 0) and (acs.X / sc) or 180
            local maxW = math.min(self._touch and 340 or 420, (vp.X - 24) / sc)
            local pillW = math.clamp(self._leftX + 6 + contentW + 18 + (self._controlsW or 70) + 12, 200, maxW)
            self:_shellRepaint()
            tween(self.Holder, { Size = UDim2.fromOffset(pillW, H), Position = UDim2.new(0.5, 0, 0, y) }, TI_POP)
        else
            -- the page stays hidden while the window grows, otherwise every card in the tab is laid out
            -- again on every frame of the animation; it appears as the window finishes opening
            local token = self._minimizeToken
            task.delay(TI_POP.Time * 0.8, function()
                if self._minimizeToken == token and not self._minimized then self._body.Visible = true end
            end)
            self._headerLine.Visible = true
            if self._pinBtn then self._pinBtn.Visible = self._pinAllowed end
            if self._subLabel then self._subLabel.Visible = true end
            self._line1.AnchorPoint = Vector2.new(0, self._hasSub and 1 or 0.5)
            self._line1.Position = UDim2.new(0, 0, 0.5, self._hasSub and 1 or 0)
            self._titleBlock.Position = UDim2.fromOffset(self._leftX, 0)
            self:_headerRelayout()
            self:_shellRepaint()
            tween(self.Holder, {
                Size = UDim2.fromOffset(self._size.X, self._size.Y),
                Position = self._preMinimizePos or UDim2.fromScale(0.5, 0.5),
            }, TI_POP)
        end
    end

    function Window:IsMinimized() return self._minimized == true end

