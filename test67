            TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 1,
        })
        self:_styleLabel(brandTitle, "Bold", 16)
        self:_bind(brandTitle, "TextColor3", "Text")
        if cfg.TitleGradient ~= false then
            -- white text so the gradient gives exact colours
            for i = #self._painters, 1, -1 do if self._painters[i].inst == brandTitle then table.remove(self._painters, i) end end
            brandTitle.TextColor3 = Color3.new(1, 1, 1)
            local tg = New("UIGradient", { Parent = brandTitle })
            self:_onTheme(brandTitle, function()
                tg.Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0, self.Theme.Text),
